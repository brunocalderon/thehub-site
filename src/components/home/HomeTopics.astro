---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import { getArticles } from "@/lib/articles";
import { topics } from "@/lib/topics";

const articles = await getArticles();
const tiles = topics.map((topic) => {
  const inTopic = articles.filter((article) => article.data.topics.includes(topic.id));
  return { topic, count: inTopic.length, latest: inTopic[0] };
});
---

<section>
  <Wrapper variant="standard" class="pt-2">
    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-4">
      {
        tiles.map(({ topic, count, latest }) => (
          <article
            class:list={[
              "relative flex flex-col gap-32 p-8 group rounded-4xl",
              topic.ground,
            ]}
          >
            <div class="flex items-start justify-between gap-4">
              <Text tag="h2" variant="displayMD" class="font-display">
                <a href={`/topics/${topic.id}`}>
                  <span class="absolute inset-0" aria-hidden="true" />
                  {topic.name}
                </a>
              </Text>
              <Button
                size="base"
                variant="muted"
                iconOnly
                class="pointer-events-none shrink-0"
                tabindex="-1"
                aria-hidden="true"
              >
                <ChevronRight slot="icon" size="base" />
              </Button>
            </div>
            <div>
              <Text tag="span" variant="textXS" class="font-display opacity-75">
                {count} articles / latest
              </Text>
              {latest && (
                <Text variant="textLG" class="mt-2 font-display text-balance">
                  {latest.data.title}
                </Text>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
