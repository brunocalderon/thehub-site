---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleBody from "@/components/articles/ArticleBody.astro";
import RelatedArticles from "@/components/articles/RelatedArticles.astro";

interface Props {
  id: string;
  frontmatter: CollectionEntry<"articles">["data"];
}

const { id, frontmatter } = Astro.props;
---

<BaseLayout>
  <ArticleBody id={id} frontmatter={frontmatter}>
    <slot />
  </ArticleBody>
  <RelatedArticles id={id} topic={frontmatter.topics[0]} />
</BaseLayout>
