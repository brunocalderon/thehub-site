---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import { getArticles } from "@/lib/articles";
import { getTopic, type TopicId } from "@/lib/topics";

interface Props {
  id: string;
  topic: TopicId;
}

const { id, topic } = Astro.props;
const articles = (await getArticles()).filter((article) => article.id !== id);
const sameTopic = articles.filter((article) => article.data.topics.includes(topic));
const related = [
  ...sameTopic,
  ...articles.filter((article) => !sameTopic.includes(article)),
].slice(0, 3);
const name = getTopic(topic)?.name;
---

<section>
  <Wrapper variant="standard" class="flex flex-col gap-2 pt-2">
    <div
      class="flex flex-col justify-between gap-6 p-8 text-white bg-foreground rounded-4xl sm:flex-row lg:items-end lg:p-12"
    >
      <Text tag="h2" variant="displayXL" class="font-display">
        Read next
      </Text>
      <Button isLink href={`/topics/${topic}`} size="sm" variant="muted" gap="xs" class="w-fit">
        More on {name}
        <ChevronRight slot="right-icon" size="xs" />
      </Button>
    </div>
    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
      {related.map((article) => <ArticleCard article={article} />)}
    </div>
  </Wrapper>
</section>
