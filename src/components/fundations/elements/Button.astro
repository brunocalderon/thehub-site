---
const {
  variant,
  size,
  onlyIconSize,
  iconOnly = false,
  gap,
  isLink = false,
  class: className,
  href,
  ...rest
} = Astro.props;

const variantClass: Record<string, string[]> = {
  default: [
    "text-white",
    "bg-foreground",
    "hover:bg-foreground",
    "focus-visible:ring-orange",
  ],
  accent: [
    "text-white",
    "bg-accent",
    "hover:bg-accent/90",
    "focus-visible:ring-orange",
  ],
  pink: [
    "text-white",
    "bg-pink",
    "hover:bg-pink/90",
    "focus-visible:ring-foreground",
  ],
  orange: [
    "text-foreground",
    "bg-orange",
    "hover:bg-orange/90",
    "focus-visible:ring-foreground",
  ],
  muted: [
    "text-foreground",
    "bg-white",
    "hover:bg-muted",
    "focus-visible:ring-accent",
  ],
  none: [],
};

const sizes: Record<string, string[]> = {
  xxs: ["h-7.5", "px-5", "py-2", "text-xs", "rounded-lg"],
  xs: ["h-9", "px-6", "py-3", "text-xs", "rounded-xl"],
  sm: ["h-10", "px-6", "py-3", "text-sm", "rounded-xl"],
  base: ["h-11", "px-8", "py-4", "text-base", "rounded-xl"],
  md: ["h-12", "px-8", "py-4", "text-md", "rounded-xl"],
  lg: ["h-13", "px-8", "py-4", "text-lg", "rounded-xl"],
  xl: ["h-14", "px-8", "py-4", "text-base", "rounded-2xl"],
  xxl: ["h-15", "px-8", "py-4", "text-lg", "rounded-2xl"],
  "16": ["h-16", "px-8", "py-4", "text-xl", "rounded-2xl"],
  "17": ["h-17", "px-8", "py-4", "text-xl", "rounded-2xl"],
  "18": ["h-18", "px-8", "py-4", "text-xl", "rounded-2xl"],
  "19": ["h-19", "px-8", "py-4", "text-xl", "rounded-2xl"],
  "20": ["h-20", "px-8", "py-4", "text-xl", "rounded-3xl"],
  "21": ["h-21", "px-8", "py-4", "text-xl", "rounded-3xl"],
  "22": ["h-22", "px-8", "py-4", "text-xl", "rounded-3xl"],
  "23": ["h-23", "px-8", "py-4", "text-xl", "rounded-3xl"],
  "24": ["h-24", "px-8", "py-4", "text-xl", "rounded-3xl"],
};

const iconSizes: Record<string, string[]> = {
  xxs: ["size-7.5", "py-2", "text-xs", "rounded-lg"],
  xs: ["size-9", "text-xs", "rounded-xl"],
  sm: ["size-10", "text-sm", "rounded-xl"],
  base: ["size-11", "text-base", "rounded-xl"],
  md: ["size-12", "text-md", "rounded-xl"],
  lg: ["size-13", "text-lg", "rounded-xl"],
  xl: ["size-14", "text-base", "rounded-2xl"],
  xxl: ["size-15", "text-lg", "rounded-2xl"],
  "16": ["size-16", "text-xl", "rounded-2xl"],
  "17": ["size-17", "text-xl", "rounded-2xl"],
  "18": ["size-18", "text-xl", "rounded-2xl"],
  "19": ["size-19", "text-xl", "rounded-2xl"],
  "20": ["size-20", "text-xl", "rounded-3xl"],
  "21": ["size-21", "text-xl", "rounded-3xl"],
  "22": ["size-22", "text-xl", "rounded-3xl"],
  "23": ["size-23", "text-xl", "rounded-3xl"],
  "24": ["size-24", "text-xl", "rounded-3xl"],
};

const gapMap: Record<string, string[]> = {
  xs: ["gap-2"],
  sm: ["gap-4"],
  base: ["gap-8"],
  md: ["gap-10"],
  lg: ["gap-12"],
};

const additionalClasses = className ? className.split(" ") : [];
const baseClass = [
  "group/button",
  "overflow-hidden",
  "flex",
  "text-center",
  "font-display",
  "justify-center",
  "font-medium",
  "items-center",
  "duration-300",
  "ease-out",
  "transition-all",
  "focus:outline-none",
  "focus-visible:ring-2",
  "active:scale-95",
];

const sizeClass = iconOnly ? iconSizes[size] : sizes[size];
const gapClass = !iconOnly && gap ? gapMap[gap] : [];
const classList = [
  ...baseClass,
  ...(variantClass[variant] || []),
  ...(sizeClass || []),
  ...additionalClasses,
];

const label = iconOnly
  ? await Astro.slots.render("icon")
  : [
      await Astro.slots.render("left-icon"),
      await Astro.slots.render("default"),
      await Astro.slots.render("right-icon"),
    ].join("");
const Tag = isLink ? "a" : "button";
const line = ["flex items-center justify-center transition-transform duration-500 ease-out", ...gapClass];
---

<Tag class:list={classList} href={isLink ? href : undefined} {...rest}>
  <span class="relative flex overflow-hidden">
    <span class:list={[line, "group-hover/button:-translate-y-full"]} set:html={label} />
    <span
      class:list={[line, "absolute inset-0 translate-y-full group-hover/button:translate-y-0"]}
      aria-hidden="true"
      set:html={label}
    />
  </span>
</Tag>
