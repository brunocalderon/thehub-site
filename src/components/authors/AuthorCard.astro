---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";

interface Props {
  author: CollectionEntry<"authors">;
  count: number;
}

const { author, count } = Astro.props;
---

<article
  class="relative flex flex-col p-2 duration-500 bg-white text-foreground group rounded-4xl hover:bg-muted"
>
  <Image
    src={author.data.portrait.url}
    alt={author.data.portrait.alt}
    width={800}
    height={800}
    class="object-cover w-full aspect-square rounded-3xl"
  />
  <div class="flex flex-col justify-between flex-1 gap-12 p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <Text tag="h2" variant="displayMD" class="font-display">
          <a href={`/authors/${author.id}`}>
            <span class="absolute inset-0" aria-hidden="true"></span>
            {author.data.name}
          </a>
        </Text>
        <Text tag="p" variant="textBase" class="mt-2 font-display text-muted-foreground">
          {author.data.role}
        </Text>
      </div>
      <Button
        size="base"
        variant="default"
        iconOnly
        class="pointer-events-none shrink-0"
        tabindex="-1"
        aria-hidden="true"
      >
        <ChevronRight slot="icon" size="base" />
      </Button>
    </div>
    <Text tag="span" variant="textSM" class="font-display text-muted-foreground">
      {count} articles
    </Text>
  </div>
</article>
