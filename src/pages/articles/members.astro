---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleArchive from "@/components/articles/ArticleArchive.astro";
import Button from "@/components/fundations/elements/Button.astro";
import { getArticles } from "@/lib/articles";

const articles = (await getArticles()).filter(
  (article) => article.data.isMembersOnly,
);
---

<BaseLayout>
  <ArticleArchive
    title="Members only"
    description="Long features, studio visits and full case studies, written for the readers who keep Tratto independent."
    articles={articles}
    current="members"
  >
    <Button isLink href="/membership" size="base" variant="muted" class="mt-8 w-fit">
      Become a member
    </Button>
  </ArticleArchive>
</BaseLayout>
