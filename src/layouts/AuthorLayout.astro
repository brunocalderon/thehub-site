---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AuthorProfile from "@/components/authors/AuthorProfile.astro";

interface Props {
  id: string;
  frontmatter: CollectionEntry<"authors">["data"];
}

const { id, frontmatter } = Astro.props;
---

<BaseLayout>
  <AuthorProfile id={id} frontmatter={frontmatter} />
</BaseLayout>
