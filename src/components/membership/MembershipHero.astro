---
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const unlocks = [
  { value: "40+", label: "Long features a year" },
  { value: "12", label: "Studio visits a year" },
  { value: "2021", label: "The archive goes back to the first issue" },
];
---

<section>
  <Wrapper variant="standard" class="pt-2">
    <div
      class="grid grid-cols-1 gap-16 px-8 pt-16 pb-8 text-white bg-foreground rounded-4xl lg:grid-cols-12 lg:p-16"
    >
      <div class="flex flex-col justify-between gap-12 lg:col-span-7">
        <div>
          <Text tag="h1" variant="display2XL" class="font-display text-balance">
            Read everything, keep us independent
          </Text>
          <Text variant="textLG" class="mt-6 font-display text-muted text-pretty">
            Most of Tratto is free. Members unlock the long features, the studio visits and the full
            archive, and pay for the next issue.
          </Text>
        </div>
        <Button isLink href="/sign-up" size="base" variant="pink" class="w-fit">
          Become a member
        </Button>
      </div>
      <dl class="flex flex-col divide-y divide-white/20 lg:col-span-5 lg:justify-end">
        {
          unlocks.map((item) => (
            <div class="flex items-baseline justify-between gap-6 py-6">
              <Text tag="dt" variant="textBase" class="text-muted text-pretty">
                {item.label}
              </Text>
              <Text tag="dd" variant="displayMD" class="font-display text-orange shrink-0">
                {item.value}
              </Text>
            </div>
          ))
        }
      </dl>
    </div>
  </Wrapper>
</section>
