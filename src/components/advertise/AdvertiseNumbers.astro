---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const numbers = [
  { value: "180k", label: "Readers a month" },
  { value: "42k", label: "Friday letter subscribers" },
  { value: "61%", label: "Work as designers" },
  { value: "3,100", label: "Paying members" },
];
---

<section>
  <Wrapper variant="standard" class="pt-2">
    <dl class="grid grid-cols-2 gap-2 lg:grid-cols-4">
      {
        numbers.map((item) => (
          <div class="flex flex-col gap-2 p-8 bg-white rounded-4xl">
            <dt class="font-display text-muted-foreground">
              <Text tag="span" variant="textBase">
                {item.label}
              </Text>
            </dt>
            <dd class="order-first font-display text-foreground">
              <Text tag="span" variant="displayXL">
                {item.value}
              </Text>
            </dd>
          </div>
        ))
      }
    </dl>
  </Wrapper>
</section>
