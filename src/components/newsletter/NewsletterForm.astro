---
import Button from "@/components/fundations/elements/Button.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";

interface Props {
  id: string;
  buttonVariant?: "accent" | "default" | "pink" | "orange";
  class?: string;
}

const { id, buttonVariant = "accent", class: className } = Astro.props;
---

<form class:list={["flex items-end w-full gap-2", className]}>
  <label for={id} class="sr-only">Email address</label>
  <input
    type="email"
    id={id}
    name="email"
    required
    autocomplete="email"
    placeholder="you@studio.test"
    class="block w-full h-20 px-4 py-2 font-display text-3xl text-white border border-transparent appearance-none bg-muted-foreground rounded-3xl duration-300 placeholder-muted focus:bg-transparent focus:outline-none focus:ring-accent focus:ring-offset-2 focus:ring-2 focus:ring-offset-background"
  />
  <Button type="submit" size="20" variant={buttonVariant} iconOnly class="shrink-0" aria-label="Subscribe">
    <ChevronRight slot="icon" size="xl" />
  </Button>
</form>
