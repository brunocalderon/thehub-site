---
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
---

<aside
  aria-label="Advertisement"
  class="grid grid-cols-1 gap-8 p-8 bg-orange rounded-4xl lg:grid-cols-3 lg:p-12"
>
  <div class="lg:col-span-2">
    <Text
      tag="p"
      variant="displaySM"
      class="font-display text-foreground text-balance"
    >
      Twelve weights, four widths, one honest price.
    </Text>
  </div>
  <div class="flex flex-col justify-between gap-8">
    <Text tag="p" variant="textSM" class="pl-8 text-foreground">
      Grafia draws grotesk families for small sizes first. Try any of them free
      on your own work for thirty days.
    </Text>
    <div class="flex items-center gap-4">
      <Button isLink href="#_" size="base" variant="default">Try Grafia</Button>
      <Text tag="span" variant="textXS" class="font-display text-foreground">
        Sponsored
      </Text>
    </div>
  </div>
</aside>
